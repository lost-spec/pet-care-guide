# LLM API Configuration (configure for your provider)
# For OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_key
# LLM_MODEL=google/gemma-4-31b-it:free
# LLM_EXTRA_HEADERS={"HTTP-Referer":"https://your-app.vercel.app","X-Title":"Pet Care Guide"}

# For local/opencode zen API (example):
# LLM_BASE_URL=http://localhost:3001/v1
# LLM_API_KEY=optional
# LLM_MODEL=your-model-name
# LLM_EXTRA_HEADERS={}